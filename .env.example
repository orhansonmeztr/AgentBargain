# ============================================================
# AgentBargain - Environment Configuration
# ============================================================
# Copy this file to .env and fill in your values:
#   cp .env.example .env
# ============================================================

# --- LLM Providers ---

# Google Gemini API key (required for Google models)
GOOGLE_API_KEY=your-google-api-key-here

# OpenAI API key (required for OpenAI models)
OPENAI_API_KEY=your-openai-api-key-here

# DeepSeek (OpenAI-compatible API). Use with a "deepseek/" model prefix, e.g.
# NEGOTIATION_MODEL=deepseek/deepseek-flash. Bare "deepseek-..." names stay on
# Ollama (e.g. a local deepseek-r1). Prompts — including each side's private
# limit — are sent to DeepSeek's servers when this provider is used.
DEEPSEEK_API_KEY=your-deepseek-api-key-here
DEEPSEEK_BASE_URL=https://api.deepseek.com

# Ollama (local models - default provider)
OLLAMA_BASE_URL=http://localhost:11434

# --- Model Configuration ---
# Format: provider/model_name (e.g., ollama/gemma3:1b, google/gemini-2.0-flash,
# deepseek/deepseek-flash)
NEGOTIATION_MODEL=ollama/gemma3:1b
EVALUATION_MODEL=ollama/qwen3:0.6b
FALLBACK_MODEL=ollama/llama3.2:1b
# Sampling temperatures. 0.2-0.5 suits structured negotiation output;
# 0.0 keeps evaluation and the fallback deterministic.
NEGOTIATION_TEMPERATURE=0.4
EVALUATION_TEMPERATURE=0.0
FALLBACK_TEMPERATURE=0.0

# --- Database ---
SQLITE_DB_PATH=data/agent_bargain.db
CHROMA_PERSIST_DIR=data/chroma_data
# Vector backend: only "chroma" ships today (see storage/vector_store.py)
VECTOR_BACKEND=chroma

# --- Server ---
# Loopback by default. Use 0.0.0.0 to accept remote connections — the app then
# refuses to start unless API_KEYS is set (or ALLOW_UNAUTHENTICATED=true).
# Docker sets 0.0.0.0 itself.
SERVER_HOST=127.0.0.1
SERVER_PORT=8000
# NOTE: the variable is APP_DEBUG, *not* DEBUG. Bare DEBUG is claimed by build
# toolchains (e.g. DEBUG=release) and used to break the app at import time.
# Set to true only for local development — it enables uvicorn hot reload.
APP_DEBUG=false
CORS_ORIGINS=["http://localhost:3000","http://localhost:8000"]

# --- Authentication ---
# Shared API keys for /api/v1, as a JSON list. Send one as `X-API-Key: <key>`,
# `Authorization: Bearer <key>`, or (WebSockets only) `?api_key=<key>`.
#
# LEAVING THIS EMPTY DISABLES AUTHENTICATION ENTIRELY. That is fine on the
# default loopback host. On any other SERVER_HOST (including Docker) the app
# refuses to start with no keys, unless ALLOW_UNAUTHENTICATED=true below.
#
#   API_KEYS=["change-me-1","change-me-2"]
#
# /health and the A2A Agent Card stay public; the A2A JSON-RPC endpoint
# (/api/v1/a2a/jsonrpc) requires a key like every other /api/v1 route.
API_KEYS=[]

# Explicit opt-in to an unauthenticated server on a non-loopback host.
# Anyone who can reach the port can then open negotiations and write to the
# reputation ledger. Leave false unless the network itself is trusted.
ALLOW_UNAUTHENTICATED=false

# Operator keys, same format. Valid everywhere API_KEYS are, and the ONLY keys
# accepted by GET /api/v1/analytics/{id}/game-theory and /analytics/aggregate:
# ZOPA/Nash analysis reveals the seller's floor and the buyer's budget. With
# authentication on and this empty, those routes answer 403 to everyone.
# Give the dashboard an admin key to see its game-theory panels.
#
#   ADMIN_API_KEYS=["change-me-admin"]
ADMIN_API_KEYS=[]

# --- Negotiation Parameters ---
# Global default. POST /api/v1/negotiations/start can override it per request
# with "max_rounds"; the limit actually used is persisted with the negotiation
# so analytics scores round efficiency against the right denominator.
MAX_NEGOTIATION_ROUNDS=10
NEGOTIATION_TIMEOUT_SECONDS=120
# Post-trade evaluation LLM limit; on expiry the deal stands but no feedback is
# recorded. Leave room for a local model to load: a warm evaluator answers in
# ~20s, a cold one (swapped in after the negotiation model) can take over a minute.
EVALUATION_TIMEOUT_SECONDS=180

# --- Observability ---
# Root log level. The app installs its own root handler at this level; without
# it Python's WARNING default silently discards every INFO line (including the
# startup message confirming whether authentication is on).
LOG_LEVEL=INFO
# LangSmith tracing. LANGSMITH_API_KEY is required — enabling tracing without a
# key logs a warning and leaves tracing disabled. Both LANGSMITH_* and legacy
# LANGCHAIN_* variable names are populated at startup.
LANGSMITH_API_KEY=your-langsmith-api-key-here
LANGSMITH_PROJECT=agent-bargain
LANGSMITH_TRACING=false
